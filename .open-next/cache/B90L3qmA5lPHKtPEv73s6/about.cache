translate-x-1/2 whitespace-nowrap text-[clamp(5rem,15vw,14rem)] font-semibold leading-none tracking-[-0.06em] text-white/[0.035]\" style=\"opacity:0;transform:translateY(40px)\">ABOUT</p><div class=\"absolute left-[8%] top-0 h-full w-px bg-white/[0.05]\"></div><div class=\"absolute right-[8%] top-0 h-full w-px bg-white/[0.05]\"></div><div class=\"absolute left-1/2 top-0 hidden h-full w-px -translate-x-1/2 bg-white/[0.03] lg:block\"></div></div><div class=\"container-shell relative flex min-h-[calc(72vh-5rem)] flex-col justify-between py-16 md:py-20 lg:py-24\"><div class=\"grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20\"><div style=\"opacity:0;transform:translateX(-24px)\"><div class=\"flex items-center gap-4\"><span class=\"h-px bg-gold\" style=\"width:0px\"></span><p class=\"text-xs font-medium tracking-[0.28em] text-brand-200\">ABOUT GOOD ANGEL</p></div></div><div><div class=\"overflow-hidden\"><h1 class=\"max-w-4xl text-4xl font-semibold leading-[1.08] tracking-[-0.045em] text-white sm:text-5xl lg:text-7xl\" style=\"transform:translateY(110%)\">認識好天使</h1></div><p class=\"mt-8 max-w-2xl text-base leading-8 text-white/55 md:text-lg md:leading-9\" style=\"opacity:0;transform:translateY(28px)\">我們結合不動產實務、財商教育與人才培育，讓不同背景的夥伴在學習、交流與實務累積中，逐步建立自己的專業方向。</p></div></div><div class=\"mt-16 flex items-end justify-between border-t border-white/10 pt-5\" style=\"opacity:0\"><div class=\"flex items-center gap-4\"><span class=\"text-[10px] font-medium tracking-[0.24em] text-white/40\">GOOD ANGEL</span><span class=\"h-px w-8 bg-gold/60\"></span><span class=\"text-[10px] font-medium tracking-[0.24em] text-white/40\">TAICHUNG · TAIWAN</span></div><span class=\"text-sm font-medium tracking-[0.2em] text-gold\">01</span></div></div></section><section class=\"relative overflow-hidden bg-ivory text-brand-900\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute -right-8 top-12 select-none text-[clamp(8rem,22vw,24rem)] font-semibold leading-none tracking-[-0.08em] text-brand-900/[0.025]\">ABOUT</div><div class=\"container-shell relative py-24 md:py-32 lg:py-40\"><div class=\"grid gap-16 lg:grid-cols-[0.82fr_1.18fr] lg:gap-24\"><div class=\"lg:sticky lg:top-28 lg:self-start\"><div style=\"opacity:0;transform:translateY(30px)\"><div class=\"flex items-center gap-4\"><span class=\"h-px w-10 bg-gold\"></span><p class=\"text-[10px] font-semibold tracking-[0.3em] text-gold\">ABOUT GOOD ANGEL</p></div><h2 class=\"mt-7 max-w-md text-4xl font-semibold leading-[1.12] tracking-[-0.045em] md:text-5xl lg:text-6xl\">不只是學習，<br/>更是<span class=\"text-brand-600\"> 成長系統。</span></h2><p class=\"mt-8 max-w-sm text-sm leading-7 text-muted md:text-base md:leading-8\">不動產 × 財商 × 人才培育</p><div class=\"relative mt-12 min-h-[640px] overflow-hidden lg:min-h-[720px]\" style=\"opacity:0;transform:translateY(40px)\"><img alt=\"好天使團隊交流與學習\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-[1400ms] hover:scale-[1.025]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 36vw\" srcSet=\"/_next/image?url=%2Fimages%2Fabout-team.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fabout-team.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fabout-team.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fabout-team.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fabout-team.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fabout-team.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fabout-team.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fabout-team.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fabout-team.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fabout-team.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fabout-team.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-brand-900/10\"></div><div class=\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-900/60 via-brand-900/10 to-transparent px-6 pb-6 pt-20\"><div class=\"flex items-center justify-between text-ivory\"><p class=\"text-[9px] font-medium tracking-[0.24em]\">GOOD ANGEL · TAICHUNG</p><span class=\"text-[10px] tracking-[0.2em] text-gold\">01</span></div></div></div><div class=\"mt-6 hidden items-end gap-4 lg:flex\"><span class=\"font-serif text-7xl font-light leading-none text-gold\">03</span><span class=\"pb-2 text-[10px] tracking-[0.28em] text-brand-900/35\">CORE FIELDS</span></div></div></div><div><div class=\"border-t border-brand-900/15 pt-10\" style=\"opacity:0;transform:translateY(50px)\"><h3 class=\"max-w-4xl text-3xl font-semibold leading-[1.35] tracking-[-0.035em] md:text-5xl md:leading-[1.22]\">我們不只分享知識，<br/>更希望陪伴每一位夥伴<span class=\"text-brand-600\"> 建立自己的專業。</span></h3><p class=\"mt-8 max-w-3xl text-base leading-8 text-muted md:text-lg md:leading-9\">好天使不動產財商團隊結合不動產實務、財商教育與人才培育， 透過學習、交流與實務經驗的累積，讓不同背景的夥伴逐步理解產業， 建立判斷能力，也找到屬於自己的成長方向。</p></div><div class=\"mt-16 border-t border-brand-900/15\"><article class=\"group relative border-b border-brand-900/15 py-10 md:py-14\" style=\"opacity:0;transform:translateY(50px)\"><div class=\"absolute inset-0 origin-left scale-x-0 bg-brand-900/[0.025] transition-transform duration-700 group-hover:scale-x-100\"></div><div class=\"relative grid gap-6 md:grid-cols-[110px_1fr_1.2fr] md:items-center\"><div><p class=\"font-serif text-5xl font-light text-gold\">01</p><p class=\"mt-3 text-[8px] tracking-[0.25em] text-brand-900/35\">REAL ESTATE</p></div><div><h3 class=\"text-2xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-brand-600 md:text-3xl\">不動產實務</h3></div><div class=\"flex items-center justify-between gap-8\"><p class=\"max-w-xl text-sm leading-7 text-muted md:text-base md:leading-8\">從市場資訊、物件分析到實際購屋流程，在真實案例中逐步建立對不動產市場的理解與判斷能力。</p><span class=\"hidden text-2xl text-gold transition-transform duration-500 group-hover:translate-x-2 md:block\">→</span></div></div></article><article class=\"group relative border-b border-brand-900/15 py-10 md:py-14\" style=\"opacity:0;transform:translateY(50px)\"><div class=\"absolute inset-0 origin-left scale-x-0 bg-brand-900/[0.025] transition-transform duration-700 group-hover:scale-x-100\"></div><div class=\"relative grid gap-6 md:grid-cols-[110px_1fr_1.2fr] md:items-center\"><div><p class=\"font-serif text-5xl font-light text-gold\">02</p><p class=\"mt-3 text-[8px] tracking-[0.25em] text-brand-900/35\">FINANCIAL LITERACY</p></div><div><h3 class=\"text-2xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-brand-600 md:text-3xl\">財商思維</h3></div><div class=\"flex items-center justify-between gap-8\"><p class=\"max-w-xl text-sm leading-7 text-muted md:text-base md:leading-8\">理解稅務、資產配置與財務規劃的基本邏輯，把零散的知識轉化成能實際運用的專業能力。</p><span class=\"hidden text-2xl text-gold transition-transform duration-500 group-hover:translate-x-2 md:block\">→</span></div></div></article><article class=\"group relative border-b border-brand-900/15 py-10 md:py-14\" style=\"opacity:0;transform:translateY(50px)\"><div class=\"absolute inset-0 origin-left scale-x-0 bg-brand-900/[0.025] transition-transform duration-700 group-hover:scale-x-100\"></div><div class=\"relative grid gap-6 md:grid-cols-[110px_1fr_1.2fr] md:items-center\"><div><p class=\"font-serif text-5xl font-light text-gold\">03</p><p class=\"mt-3 text-[8px] tracking-[0.25em] text-brand-900/35\">PROFESSIONAL GROWTH</p></div><div><h3 class=\"text-2xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-brand-600 md:text-3xl\">專業成長</h3></div><div class=\"flex items-center justify-between gap-8\"><p class=\"max-w-xl text-sm leading-7 text-muted md:text-base md:leading-8\">透過團隊交流、經驗分享與持續學習，在累積實務經驗的同時，探索適合自己的職涯發展方向。</p><span class=\"hidden text-2xl text-gold transition-transform duration-500 group-hover:translate-x-2 md:block\">→</span></div></div></article></div><div class=\"mt-16 grid gap-8 border-t border-brand-900/15 pt-12 md:grid-cols-[0.35fr_1.65fr]\" style=\"opacity:0;transform:translateY(40px)\"><p class=\"text-[10px] font-semibold tracking-[0.28em] text-gold\">OUR PURPOSE</p><div><p class=\"max-w-4xl text-xl font-medium leading-[1.75] md:text-3xl md:leading-[1.65]\">我們相信，一個人的起點不代表終點。<span class=\"text-brand-600\"> <!-- -->願意學習、願意累積、願意與團隊一起前進，</span>就有機會走出自己的專業道路。</p><div class=\"mt-10 h-px w-full overflow-hidden bg-brand-900/10\"><div class=\"h-full bg-gold\" style=\"width:0px\"></div></div></div></div></div></div></div></section></main><footer class=\"relative overflow-hidden bg-brand-900 text-ivory\"><div class=\"h-px origin-left bg-gold/70\" style=\"transform:scaleX(0)\"></div><div class=\"container-shell relative\"><div class=\"grid gap-16 py-20 md:py-28 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24\"><div style=\"opacity:0;transform:translateY(40px)\"><p class=\"text-[9px] font-semibold tracking-[0.32em] text-gold\">GOOD ANGEL / TAICHUNG</p><h2 class=\"mt-7 max-w-xl text-3xl font-semibold leading-[1.25] tracking-[-0.04em] text-white md:text-5xl\">與願意成長的人，<br/><span class=\"text-brand-200\">一起走得更遠。</span></h2><p class=\"mt-8 max-w-md text-sm leading-7 text-white/45\">結合不動產實務、財商教育與人才培育， 與願意學習、願意成長的夥伴一起累積專業。</p><div class=\"mt-12 flex max-w-lg flex-wrap gap-x-7 gap-y-4\"><span class=\"text-[9px] tracking-[0.25em] text-white/30\">REAL ESTATE</span><span class=\"text-[9px] tracking-[0.25em] text-white/30\">FINANCE</span><span class=\"text-[9px] tracking-[0.25em] text-white/30\">PEOPLE</span><span class=\"text-[9px] tracking-[0.25em] text-white/30\">GROWTH</span></div></div><nav class=\"border-t border-white/15\"><div style=\"opacity:0;transform:translateX(30px)\"><a class=\"group relative flex items-center justify-between overflow-hidden border-b border-white/15 py-5 md:py-6\" href=\"/\"><div class=\"absolute inset-0 origin-left scale-x-0 bg-white/[0.035] transition-transform duration-500 group-hover:scale-x-100\"></div><div class=\"relative flex items-center gap-6\