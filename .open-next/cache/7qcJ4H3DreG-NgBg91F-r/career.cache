2 -translate-x-1/2 whitespace-nowrap text-[clamp(5rem,15vw,14rem)] font-semibold leading-none tracking-[-0.06em] text-white/[0.035]\" style=\"opacity:0;transform:translateY(40px)\">GOOD ANGEL</p><div class=\"absolute left-[8%] top-0 h-full w-px bg-white/[0.05]\"></div><div class=\"absolute right-[8%] top-0 h-full w-px bg-white/[0.05]\"></div><div class=\"absolute left-1/2 top-0 hidden h-full w-px -translate-x-1/2 bg-white/[0.03] lg:block\"></div></div><div class=\"container-shell relative flex min-h-[calc(72vh-5rem)] flex-col justify-between py-16 md:py-20 lg:py-24\"><div class=\"grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20\"><div style=\"opacity:0;transform:translateX(-24px)\"><div class=\"flex items-center gap-4\"><span class=\"h-px bg-gold\" style=\"width:0px\"></span><p class=\"text-xs font-medium tracking-[0.28em] text-brand-200\">JOIN GOOD ANGEL</p></div></div><div><div class=\"overflow-hidden\"><h1 class=\"max-w-4xl text-4xl font-semibold leading-[1.08] tracking-[-0.045em] text-white sm:text-5xl lg:text-7xl\" style=\"transform:translateY(110%)\">加入好天使</h1></div><p class=\"mt-8 max-w-2xl text-base leading-8 text-white/55 md:text-lg md:leading-9\" style=\"opacity:0;transform:translateY(28px)\">我們正在尋找願意學習、願意交流，也願意和團隊一起成長的夥伴。你的起點不必相同，但我們可以朝同一個方向前進。</p></div></div><div class=\"mt-16 flex items-end justify-between border-t border-white/10 pt-5\" style=\"opacity:0\"><div class=\"flex items-center gap-4\"><span class=\"text-[10px] font-medium tracking-[0.24em] text-white/40\">GOOD ANGEL</span><span class=\"h-px w-8 bg-gold/60\"></span><span class=\"text-[10px] font-medium tracking-[0.24em] text-white/40\">TAICHUNG · TAIWAN</span></div><span class=\"text-sm font-medium tracking-[0.2em] text-gold\">01</span></div></div></section><section class=\"relative overflow-hidden bg-ivory text-brand-900\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute -right-10 top-10 select-none text-[clamp(7rem,18vw,18rem)] font-semibold leading-none tracking-[-0.07em] text-brand-900/[0.025]\">PEOPLE</div><div class=\"container-shell relative py-24 md:py-32 lg:py-36\"><div class=\"grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24\"><div><div class=\"flex items-center gap-4\" style=\"opacity:0;transform:translateY(24px)\"><span class=\"h-px w-8 bg-gold\"></span><p class=\"text-[10px] font-semibold tracking-[0.28em] text-gold\">WHO WE ARE LOOKING FOR</p></div><div class=\"relative mt-10 aspect-[4/5] w-full overflow-hidden bg-brand-900/5\" style=\"opacity:0;transform:translateY(35px)\"><img alt=\"好天使團隊交流與職涯成長\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-center transition-transform duration-[1400ms] hover:scale-[1.025]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 42vw\" srcSet=\"/_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fcareer-team.png&amp;w=3840&amp;q=75\"/><div class=\"pointer-events-none absolute inset-0 bg-brand-900/10\"></div><div class=\"pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-900/75 via-brand-900/15 to-transparent px-6 pb-6 pt-24\"><div class=\"flex items-end justify-between\"><div><p class=\"text-[9px] font-medium tracking-[0.28em] text-gold\">PEOPLE · LEARNING · GROWTH</p><p class=\"mt-2 text-sm text-white/70\">GOOD ANGEL · TAICHUNG</p></div><span class=\"text-[10px] tracking-[0.2em] text-white/60\">01</span></div></div></div></div><div class=\"lg:pt-16\"><div style=\"opacity:0;transform:translateY(45px)\"><h2 class=\"max-w-4xl text-3xl font-semibold leading-[1.28] tracking-[-0.035em] md:text-5xl lg:text-6xl\">我們在找的，<br/><span class=\"text-brand-600\">不只是漂亮的履歷。</span></h2><p class=\"mt-8 max-w-3xl text-base leading-8 text-muted md:text-lg md:leading-9\">經驗與專業可以持續累積。 比起一開始就什麼都會，我們更在意一個人面對新事物的態度， 以及是否願意與團隊共同前進。</p></div><div class=\"mt-14 border-t border-brand-900/15\"><article class=\"group relative border-b border-brand-900/15 py-9\" style=\"opacity:0;transform:translateY(35px)\"><div class=\"absolute inset-0 origin-left scale-x-0 bg-brand-900/[0.025] transition-transform duration-700 group-hover:scale-x-100\"></div><div class=\"relative grid gap-5 md:grid-cols-[80px_0.75fr_1.25fr] md:items-start\"><span class=\"font-serif text-4xl font-light text-gold\">01</span><h3 class=\"text-2xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-brand-600\">願意學習</h3><p class=\"leading-8 text-muted\">不需要一開始就熟悉所有不動產與財商知識，我們更重視你是否願意理解產業、主動學習並持續累積。</p></div><span class=\"absolute bottom-0 left-0 h-px w-0 bg-gold transition-all duration-700 group-hover:w-full\"></span></article><article class=\"group relative border-b border-brand-900/15 py-9\" style=\"opacity:0;transform:translateY(35px)\"><div class=\"absolute inset-0 origin-left scale-x-0 bg-brand-900/[0.025] transition-transform duration-700 group-hover:scale-x-100\"></div><div class=\"relative grid gap-5 md:grid-cols-[80px_0.75fr_1.25fr] md:items-start\"><span class=\"font-serif text-4xl font-light text-gold\">02</span><h3 class=\"text-2xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-brand-600\">願意交流</h3><p class=\"leading-8 text-muted\">我們相信好的團隊來自彼此分享觀點與經驗，願意溝通、傾聽與合作，是一起前進的重要基礎。</p></div><span class=\"absolute bottom-0 left-0 h-px w-0 bg-gold transition-all duration-700 group-hover:w-full\"></span></article><article class=\"group relative border-b border-brand-900/15 py-9\" style=\"opacity:0;transform:translateY(35px)\"><div class=\"absolute inset-0 origin-left scale-x-0 bg-brand-900/[0.025] transition-transform duration-700 group-hover:scale-x-100\"></div><div class=\"relative grid gap-5 md:grid-cols-[80px_0.75fr_1.25fr] md:items-start\"><span class=\"font-serif text-4xl font-light text-gold\">03</span><h3 class=\"text-2xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-brand-600\">願意成長</h3><p class=\"leading-8 text-muted\">每個人的起點與專長都不同，重要的是願意從實務中累積經驗，逐步建立自己的專業方向。</p></div><span class=\"absolute bottom-0 left-0 h-px w-0 bg-gold transition-all duration-700 group-hover:w-full\"></span></article></div></div></div></div></section><section class=\"relative overflow-hidden bg-paper text-brand-900\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute -left-6 bottom-[-3rem] select-none text-[clamp(7rem,20vw,20rem)] font-semibold leading-none tracking-[-0.07em] text-brand-900/[0.02]\">GROW</div><div class=\"container-shell relative py-24 md:py-32 lg:py-36\"><div class=\"grid gap-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24\"><div style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex items-center gap-4\"><span class=\"h-px w-8 bg-gold\"></span><p class=\"text-[10px] font-semibold tracking-[0.28em] text-gold\">WHAT YOU WILL EXPLORE</p></div><h2 class=\"mt-7 max-w-2xl text-3xl font-semibold leading-[1.3] tracking-[-0.035em] md:text-5xl\">在這裡，<br/><span class=\"text-brand-600\">專業從實際參與開始。</span></h2><p class=\"mt-8 max-w-xl text-base leading-8 text-muted md:text-lg md:leading-9\">好天使結合不動產實務、財商教育與人才培育。 在參與團隊的過程中，你會逐步接觸不同領域的知識與經驗。</p></div><div class=\"border-t border-brand-900/15\"><div class=\"group relative flex items-center justify-between gap-6 border-b border-brand-900/15 py-8\" style=\"opacity:0;transform:translateX(35px)\"><div class=\"flex items-center gap-6\"><span class=\"font-serif text-3xl font-light text-gold\">01</span><p class=\"text-lg font-medium transition-colors duration-300 group-hover:text-brand-600 md:text-xl\">不動產市場與實務</p></div><span class=\"text-xl text-gold transition-transform duration-300 group-hover:translate-x-2\">→</span></div><div class=\"group relative flex items-center justify-between gap-6 border-b border-brand-900/15 py-8\" style=\"opacity:0;transform:translateX(35px)\"><div class=\"flex items-center gap-6\"><span class=\"font-serif text-3xl font-light text-gold\">02</span><p class=\"text-lg font-medium transition-colors duration-300 group-hover:text-brand-600 md:text-xl\">財商觀念與資產思維</p></div><span class=\"text-xl text-gold transition-transform duration-300 group-hover:translate-x-2\">→</span></div><div class=\"group relative flex items-center justify-between gap-6 border-b border-brand-900/15 py-8\" style=\"opacity:0;transform:translateX(35px)\"><div class=\"flex items-center gap-6\"><span class=\"font-serif text-3xl font-light text-gold\">03</span><p class=\"text-lg font-medium transition-colors duration-300 group-hover:text-brand-600 md:text-xl\">案例討論與經驗交流</p></div><span class=\"text-xl text-gold transition-transform duration-300 group-hover:translate-x-2\">→</span></div><div class=\"group relative flex items-center justify-between gap-6 border-b border-brand-900/15 py-8\" style=\"opacity:0;transform:translateX(35px)\"><div class=\"flex items-center gap-6\"><span class=\"font-serif text-3xl font-light text-gold\">04</span><p class=\"text-lg font-medium transition-colors duration-300 group-hover:text-brand-600 md:text-xl\">團隊合作與專業成長</p></div><span class=\"text-xl text-gold transition-transform duration-300 group-hover:translate-x-2\">→</span></div></div></div></div></section><section class=\"relative overflow-hidden bg-brand-900 text-ivory\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute bottom-[-2vw] left-1/2 -translate-x-1/2 select-none whitespace-nowrap text-[clamp(5rem,14vw,14rem)] font-semibold leading-none tracking-[-0.06em] text-white/[0.025]\">JOIN US</div><div class=\"container-shell relative py-24 md:py-28 lg:py-32\"><div class=\"grid gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-24\"><div style=\"opacity:0;transform:translateY(40px)\"><p class=\"text-[10px] font-semibold tracking-[0.28em] text-gold\">START YOUR NEXT CHAPTER</p><h2 class=\"mt-7 max-w-4xl text-4xl font-semibold leading-[1.18] tracking-[-0.045em] md:text-6xl\">如果你也想看看，<br/><span class=\"text-brand-200\">自己還能走到哪裡。</span></h2></div><div style=\"opacity:0;transform:translateY(35px)\"><p class=\"max-w-xl text-base leading-8 text-white/60\">想進一步了解團隊、工作機會或加入方式，歡迎直接與好天使聯絡。</p><a class=\"group mt-9 inline-flex min-w-[210px] items-center justify-between bg-[#c7d98f] px-7 py-4 text-sm font-semibold tracking-wide text-[#1f3326] transition-all duration-300 hover:bg-[#dbe8b4]\" href=\"/contact\"><span>與我們聯絡</span><span aria-hidden=\"true\" class=\"transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1\">↗</span></a></div></div></div></section></main><footer class=\"relative overflow-hidden bg-brand-900 text-ivory\"><div class=\"h-px origin-left bg-gold/70\" style=\"transform:scaleX(0)\"></div><div class=\"container-shell relative\"><div class=\"grid gap-16 py-20 md:py-28 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24\"><div style=\"opacity:0;transform:translateY(40px)\"><p class=\"text-[9px] font-semibold tracking-[0.32em] text-gold\">GOOD ANGEL / TAICHUNG</p><h2 class=\"mt-7 max-w-xl text-3xl font-semibold leading-[1.25] tracking-[-0.04em] text-white md:text-5xl\">與願意成長的人，<br/><span class=\"text-brand-200\">一起走得更遠。</span></h2><p class=\"mt-8 max-w-md text-sm leading-7 text-white/45\">結合不動產實務、財商教育與人才培育， 與願意學習、願意成長的夥伴一起累積專業。</p><div class=\"mt-12 flex max-w-lg flex-wrap gap-x-7 gap-y-4\"><span class=\"text-[9px] tracking-[0.25em] text-white/30\">REAL ESTATE</span><span class=\"text-[9px] tracking-[0.25em] text-white/30\">FINANCE</span><span class=\"text-[9px] tracking-[0.25em] text-white/30\">PEOPLE</span><span c